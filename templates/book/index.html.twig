{% extends 'base.html.twig' %}

{% block title %}Hello BookController!{% endblock %}

{% block body %}

<div class="example-wrapper">

    <h2>Liste des livres</h2>
    {% if books %}
    {% for book in books %}

        <p>{{ book.title }} - {{ book.author }}</p>
        <a href="{{ path('app_books_show', {id: book.id}) }}">
            Voir le détail
        </a>

    {% endfor %}
    {% else %}
    <p>Aucun livre disponible</p>
    {% endif %}
</div>
{% endblock %}
