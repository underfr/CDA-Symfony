{% extends 'base.html.twig' %}

{% block title %}Hello {{ controller_name }}!{% endblock %}

{% block body %}
    <twig:Card class="mx-auto max-w-2xl">
        <twig:Card:Header class="border-b">
            <twig:Card:Title class="text-xl">Hello {{ controller_name }}! ✅</twig:Card:Title>
            <twig:Card:Description>Ce message vient de :</twig:Card:Description>
        </twig:Card:Header>

        <twig:Card:Content>
            <ul class="flex flex-col gap-3">
                <li class="flex flex-col items-start gap-1.5 sm:flex-row sm:items-center sm:gap-3">
                    <twig:Badge variant="secondary" class="w-24 justify-center">Contrôleur</twig:Badge>
                    <code class="rounded-md bg-muted px-2 py-1 font-mono text-xs">src/Controller/TestController.php</code>
                </li>
                <li class="flex flex-col items-start gap-1.5 sm:flex-row sm:items-center sm:gap-3">
                    <twig:Badge variant="secondary" class="w-24 justify-center">Template</twig:Badge>
                    <code class="rounded-md bg-muted px-2 py-1 font-mono text-xs">templates/test/index.html.twig</code>
                </li>
            </ul>
        </twig:Card:Content>
    </twig:Card>
    <section class="mx-auto mt-10 flex max-w-2xl flex-col gap-3">
        <h2 class="text-lg font-semibold tracking-tight">Exercice 3 — Alertes</h2>

        <twig:Alert message="Bienvenue sur le site !" />
        <twig:Alert message="Enregistrement réussi." type="success" />
        <twig:Alert message="Une erreur est survenue." type="danger" />
    </section>
{% endblock %}
